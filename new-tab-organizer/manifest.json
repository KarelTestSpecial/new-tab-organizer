{
  "manifest_version": 3,
  "name": "NewTab Startpage Organizer Dashboard",
  "version": "6.2",
  "description": "Turn your new tab into an organized workspace. Keep bookmarks separated by context. Minimalist and beautiful.",
  "permissions": [
    "bookmarks",
    "storage",
    "tabs"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "panel.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "chrome_url_overrides": {
    "newtab": "panel.html"
  },
  "action": {
    "default_icon": {
      "16": "assets/icon.png",
      "48": "assets/icon.png",
      "128": "assets/icon.png"
    }
  },
  "icons": {
    "16": "assets/icon.png",
    "48": "assets/icon.png",
    "128": "assets/icon.png"
  }
}